# Proveedor de IA: "groq" (Groq, tier gratis) o "claude" (Anthropic, de pago)
AI_PROVIDER=groq

# Groq (https://console.groq.com) — tier gratis con límites por minuto/día
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
GROQ_TIMEOUT_MS=60000

# Anthropic (opcional, solo si AI_PROVIDER=claude)
ANTHROPIC_API_KEY=
ANTHROPIC_BASE_URL=
CLAUDE_MODEL=claude-opus-4-1

# ElevenLabs (voz)
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
# Modelo de voz: eleven_v3 (expresivo, con tags de emoción), eleven_flash_v2_5 (rápido)
ELEVENLABS_MODEL=eleven_v3

# ── WhatsApp (Elara en tu celular, vía Baileys — no oficial) ─────────
# Número propio de Elara (solo dígitos, con código de país, ej: 5491122334455).
# Solo hace falta en el primer arranque: vincula por código de 8 dígitos en
# Ajustes → Dispositivos vinculados → Vincular dispositivo → Vincular con número.
# Si lo dejás vacío, se muestra un QR para escanear.
WA_PAIRING_NUMBER=

# Número autorizado a hablar con Elara (solo dígitos, con código de país).
# Vacío = cualquiera que le escriba recibe respuesta.
WA_OWNER_NUMBER=

# Forma de responder: voice (nota de voz, por defecto), text o both.
# voice/both requieren ELEVENLABS_API_KEY + ffmpeg instalado.
WA_REPLY_MODE=voice

# Horarios en los que Elara te escribe primero, hora local, formato HH:MM
# separados por coma (ej: 09:00,21:30). Vacío = nunca escribe primero.
WA_PROACTIVE_TIMES=

# Carpeta de la sesión de WhatsApp (no commitear; borrarla desvincula el número)
WA_AUTH_DIR=wa_auth

# Logs detallados de la conexión de Baileys: debug, info, warn… (vacío = mudo)
WA_LOG_LEVEL=

# Modelo de transcripción para notas de voz que recibas (Groq Whisper, gratis)
GROQ_WHISPER_MODEL=whisper-large-v3-turbo

# ── Telegram (Elara en tu celular, vía Bot API oficial — gratis) ─────
# Token del bot: crealo con @BotFather (/newbot) y pegalo acá.
TG_BOT_TOKEN=

# ID numérico de TU usuario de Telegram (mirá la consola cuando te escriba).
# También acepta @username. Vacío = cualquiera que hable recibe respuesta.
TG_OWNER_ID=

# Forma de responder: voice (nota de voz), text (texto), both (ambos) o mixed (variado entre texto y voz).
TG_REPLY_MODE=mixed

# Horarios en los que Elara te escribe primero, hora local, formato HH:MM
# separados por coma (ej: 09:00,21:30). Vacío = nunca escribe primero.
TG_PROACTIVE_TIMES=
