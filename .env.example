# Proveedor de IA: "groq" (Groq, tier gratis) o "claude" (Anthropic, de pago)
AI_PROVIDER=groq

# Groq (https://console.groq.com) — tier gratis con límites por minuto/día
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
GROQ_TIMEOUT_MS=60000

# Anthropic (opcional, solo si AI_PROVIDER=claude)
ANTHROPIC_API_KEY=
ANTHROPIC_BASE_URL=
CLAUDE_MODEL=claude-opus-4-1

# ElevenLabs (voz)
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
# Modelo de voz: eleven_v3 (expresivo, con tags de emoción), eleven_flash_v2_5 (rápido)
ELEVENLABS_MODEL=eleven_v3

# ── WhatsApp (Jarvis en tu celular, vía Baileys — no oficial) ─────────
# Número propio de Jarvis (solo dígitos, con código de país, ej: 5491122334455).
# Solo hace falta en el primer arranque: vincula por código de 8 dígitos en
# Ajustes → Dispositivos vinculados → Vincular dispositivo → Vincular con número.
# Si lo dejás vacío, se muestra un QR para escanear.
WA_PAIRING_NUMBER=

# Número autorizado a hablar con Jarvis (solo dígitos, con código de país).
# Vacío = cualquiera que le escriba recibe respuesta.
WA_OWNER_NUMBER=

# Forma de responder: voice (nota de voz, por defecto), text o both.
# voice/both requieren ELEVENLABS_API_KEY + ffmpeg instalado.
WA_REPLY_MODE=voice

# Horarios en los que Jarvis te escribe primero, hora local, formato HH:MM
# separados por coma (ej: 09:00,21:30). Vacío = nunca escribe primero.
WA_PROACTIVE_TIMES=

# Carpeta de la sesión de WhatsApp (no commitear; borrarla desvincula el número)
WA_AUTH_DIR=wa_auth

# Logs detallados de la conexión de Baileys: debug, info, warn… (vacío = mudo)
WA_LOG_LEVEL=

# Modelo de transcripción para notas de voz que recibas (Groq Whisper, gratis)
GROQ_WHISPER_MODEL=whisper-large-v3-turbo

# ── Poderes ──────────────────────────────────────────────────────
# Ciudad default para la herramienta de clima (Open-Meteo, sin API key).
WEATHER_LOCATION=Buenos Aires

# Recordatorios: se guardan en data/reminders.json, no requieren config.
# Se entregan por el canal que esté corriendo (Telegram, WhatsApp o terminal).
# Para recibirlos por Telegram necesitás TG_OWNER_ID numérico; por WhatsApp,
# WA_OWNER_NUMBER.

# ── Cara / ventana de escritorio ───────────────────────────────────
# Puerto del servidor que sirve la cara (Electron y el navegador entran acá).
FACE_PORT=
# Cómo se abre la cara: electron (ventana de escritorio, default) o browser
# (pestaña del navegador).
FACE_WINDOW=
# Qué avatar mostrar: vrm (3D, default), pixel (pixel art) o live2d (Live2D).
FACE_STYLE=

# ── Telegram (Jarvis en tu celular, vía Bot API oficial — gratis) ─────
# Token del bot: crealo con @BotFather (/newbot) y pegalo acá.
TG_BOT_TOKEN=

# ID numérico de TU usuario de Telegram (mirá la consola cuando te escriba).
# También acepta @username. Vacío = cualquiera que hable recibe respuesta.
TG_OWNER_ID=

# Forma de responder: voice (nota de voz), text (texto), both (ambos) o mixed (variado entre texto y voz).
TG_REPLY_MODE=mixed

# Master switch de los mensajes que Jarvis manda sin que la hablen
# (horarios proactivos + antojos espontáneos).
# false = solo responde cuando le escribís. true = puede escribir primero
# (respeta TG_PROACTIVE_TIMES y la ventana de los antojos).
TG_OUTREACH_ENABLED=false

# Horarios en los que Jarvis te escribe primero, hora local, formato HH:MM
# separados por coma (ej: 09:00,21:30). Vacío = nunca escribe primero.
TG_PROACTIVE_TIMES=

# ── Mensajes espontáneos (Jarvis escribe cuando quiere) ──────────────
# Requieren TG_OUTREACH_ENABLED=true. Con eso activo, funcionan solos
# (ventana 09:00-23:00, entre 45 y 180 min de silencio), pero podés ajustarlos:
# Ventana horaria en la que puede escribir por antojo (cruza medianoche ok: 20:00-01:00)
TG_SPONTANEOUS_WINDOW=09:00-23:00
# Minutos de silencio mínimos antes de un antojo
TG_SPONTANEOUS_MIN_MINUTES=45
# Delay máximo entre antojos (aleatorio entre min y max)
TG_SPONTANEOUS_MAX_MINUTES=180
