{
  "name": "jarvis-ai",
  "version": "1.0.0",
  "description": "Jarvis: personal AI butler with memory, voice, avatar and real tools (reminders, weather, computer control).",
  "type": "module",
  "scripts": {
    "dev": "tsx src/main.ts",
    "test:groq": "tsx src/ai/test-groq.ts",
    "models:groq": "tsx scripts/list-groq-models.ts",
    "test:voice": "tsx src/voice/test-voice.ts",
    "wa": "tsx src/whatsapp/main.ts",
    "tg": "tsx src/telegram/main.ts",
    "desktop": "electron desktop/main.mjs",
    "face": "tsx scripts/serve-mock.ts",
    "build": "tsc && node -e \"const fs=require('fs'); for (const f of ['avatar.html','pixel.html','vrm.html']) fs.copyFileSync('src/face/'+f,'dist/face/'+f); fs.cpSync('src/face/vendor','dist/face/vendor',{recursive:true})\"",
    "start": "node dist/telegram/main.js"
  },
  "keywords": [
    "ai",
    "claude",
    "anthropic",
    "typescript",
    "nodejs",
    "jarvis",
    "voice-assistant",
    "personal-assistant"
  ],
  "author": "Franco",
  "license": "ISC",
  "dependencies": {
    "@anthropic-ai/sdk": "^0.28.0",
    "@elevenlabs/elevenlabs-js": "^2.64.0",
    "@whiskeysockets/baileys": "^7.0.0-rc14",
    "dotenv": "^17.4.2",
    "grammy": "^1.46.0",
    "groq-sdk": "^1.6.0",
    "pino": "^10.3.1",
    "qrcode-terminal": "^0.12.0",
    "wave": "^0.2.3"
  },
  "devDependencies": {
    "@types/node": "^26.3.0",
    "@types/qrcode-terminal": "^0.12.2",
    "electron": "^41.7.1",
    "tsx": "^4.23.12",
    "typescript": "^7.0.2"
  }
}
